# Copy to .env and fill in. NEVER commit .env.
# Easiest way: start opencode in this repo and ask for "setup" - the onboarding
# agent interviews you and writes this file (and profile.json) for you.

# Notion integration secret token (create at https://www.notion.so/profile/integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jobs database id (32-char id from the database URL)
NOTION_DATABASE_ID=32-char-id-from-database-url

# Watcher Run Log database id (optional - if missing, run-log rows are skipped)
# NOTION_LOG_DATABASE_ID=32-char-id-from-database-url

# --- Legacy standalone watcher (watcher.mjs) only ---
RUN_ON_START=true
INTERVAL_MS=3600000
PORT=3000

# Optional: force a specific opencode model for scheduled runs, e.g.
# WATCH_MODEL=zai-coding-plan/glm-5.3-flash
# If unset, your opencode default model is used.
